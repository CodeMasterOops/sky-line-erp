APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://pos-saas.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
 DB_HOST=127.0.0.1
 DB_PORT=3306
 DB_DATABASE=pos_saas
 DB_USERNAME=root
 DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Local dev (no Redis): database drivers — run migrations for jobs + cache tables
QUEUE_CONNECTION=database
QUEUE_WORKER_QUEUES=data-transfer-heavy,data-transfer,default,ird

CACHE_STORE=database

# ─── PRODUCTION REQUIRED ───────────────────────────────────────────────────────
# Database-backed queue/cache/sessions collapse under concurrent load.
# Set all three of the following in production (docker-compose.redis.yml or managed Redis):
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# SESSION_DRIVER=redis

MEMCACHED_HOST=127.0.0.1

# Managed Redis (Coolify): omit /0 from URL so REDIS_CACHE_DB / REDIS_QUEUE_DB apply
# REDIS_URL=redis://default:YOUR_PASSWORD@your-redis-host:6379
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE_RETRY_AFTER=3900

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# QZ Tray thermal printing — signing certificate + private key.
# Leave all blank to run QZ Tray in unsigned mode (shows a one-time "Allow" prompt).
#
# Option A — file paths (traditional servers):
QZ_CERTIFICATE_PATH=
QZ_PRIVATE_KEY_PATH=
#
# Option B — base64-encoded content (Coolify / Docker — recommended):
# Generate with: base64 -w 0 qz-cert.pem  and  base64 -w 0 qz-private.pem
QZ_CERTIFICATE_BASE64=
QZ_PRIVATE_KEY_BASE64=
#
QZ_PRIVATE_KEY_PASSPHRASE=
QZ_SIGNATURE_ALGORITHM=SHA512

REGISTRATION_ENABLED=false 